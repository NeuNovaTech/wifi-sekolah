# Contoh konfigurasi produksi (SQLite + Express melayani file web).
# Salin ke api/.env lalu sesuaikan.

APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

PORT=8090
HOST=127.0.0.1
SERVE_STATIC=true
TRUST_PROXY=true

DB_DRIVER=sqlite
DB_SQLITE_PATH=./storage/database.sqlite

SESSION_NAME=WIFI_SESSID
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Catatan:
# - HOST=127.0.0.1 cocok bila di belakang Nginx/Caddy di mesin yang sama.
# - Untuk Docker/Render, gunakan HOST=0.0.0.0 (sudah diatur di Dockerfile).
# - TRUST_PROXY=true wajib agar cookie sesi ditandai aman (Secure) di HTTPS.
